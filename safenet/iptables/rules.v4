# =============================================================================
# SafeNet iptables Firewall Rules
# =============================================================================
# Purpose: Browse-only policy enforcement at the network level
# Location: /etc/iptables/rules.v4
#
# BROWSE-ONLY ENFORCEMENT:
# - FTP blocked (ports 20-21) - No file sharing
# - BitTorrent blocked (ports 6881-6999, DHT 6771) - No torrenting
# - UDP blocked except DNS (port 53) - Kills streaming protocols
#
# These rules work in conjunction with DNS blocking (streaming CDNs)
# to enforce the SafeNet Terms of Service.
#
# Restore with: iptables-restore < /etc/iptables/rules.v4
# =============================================================================

*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

# --- Browse-Only Policy Enforcement ---

# Block FTP (no file sharing via VPN)
-A FORWARD -p tcp -m tcp --sport 20:21 -j DROP
-A FORWARD -p tcp -m tcp --dport 20:21 -j DROP

# Block BitTorrent DHT
-A FORWARD -p udp -m udp --sport 6771 -j DROP
-A FORWARD -p udp -m udp --dport 6771 -j DROP

# Block BitTorrent standard ports
-A FORWARD -p udp -m udp --sport 6881:6999 -j DROP
-A FORWARD -p udp -m udp --dport 6881:6999 -j DROP
-A FORWARD -p tcp -m tcp --sport 6881:6999 -j DROP
-A FORWARD -p tcp -m tcp --dport 6881:6999 -j DROP

# Block ALL new outbound UDP except DNS (kills streaming, gaming, VoIP)
# This is the key rule that makes SafeNet "browse-only"
-A FORWARD -p udp -m udp ! --dport 53 -m conntrack --ctstate NEW -j DROP

# Allow WireGuard tunnel traffic (after policy rules)
-A FORWARD -i wg0 -j ACCEPT

COMMIT

# =============================================================================
# NAT Rules
# =============================================================================
# Masquerade VPN traffic to appear from server's public IP

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

# NAT all tunnel traffic through the public interface
-A POSTROUTING -o nic1 -j MASQUERADE

COMMIT
