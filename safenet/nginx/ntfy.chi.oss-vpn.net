# =============================================================================
# ntfy Push Notification Proxy
# =============================================================================
# Purpose: Reverse proxy for ntfy push notification service
# Location: /etc/nginx/sites-available/ntfy.chi.oss-vpn.net
#
# ntfy provides real-time push notifications to OSS engineers for:
# - Blocklist update counts (daily)
# - Monit alerts (service failures, resource warnings)
# - Security events (root logins, fail2ban triggers)
# - Backup completion notifications
#
# WebSocket support enabled for live subscription feeds.
# =============================================================================

server {
    listen 80;
    server_name ntfy.chi.oss-vpn.net;

    access_log /var/log/nginx/ntfy-access.log;
    error_log /var/log/nginx/ntfy-error.log;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (for live subscriptions)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Long-polling support
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        # Don't buffer (needed for streaming)
        proxy_buffering off;
        proxy_cache off;
    }
}
